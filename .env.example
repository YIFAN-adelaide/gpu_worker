# ---------------------------------------------------------------------------
# Portable GPU worker
# Copy this file to gpu_worker/.env on each machine.
# ---------------------------------------------------------------------------

GPU_SERVICE_HOST=0.0.0.0
GPU_SERVICE_PORT=8001

# Optional. Leave blank on localhost-only development if desired.
# For an externally reachable AWS worker, set a strong secret and configure
# both RemoteLLMProvider and RemoteInferenceClient with the same value.
GPU_SERVICE_API_KEY=

GPU_QUEUE_MAXSIZE=32
GPU_EMBED_TIMEOUT_SECONDS=90
GPU_DECOMPOSE_TIMEOUT_SECONDS=120
GPU_GENERATE_TIMEOUT_SECONDS=600

# ---------------------------------------------------------------------------
# Which physical models should this machine load?
#
# Small local GPU example:
# GPU_LOAD_EMBEDDING=true
# GPU_LOAD_SMALL_LLM=true
# GPU_LOAD_RESPONSE_LLM=false
#
# Full AWS GPU example:
# all three = true
# ---------------------------------------------------------------------------

GPU_LOAD_EMBEDDING=true
GPU_LOAD_SMALL_LLM=true
GPU_LOAD_RESPONSE_LLM=true

# ---------------------------------------------------------------------------
# Machine-specific model paths
# ---------------------------------------------------------------------------

BGE_MODEL_PATH=/path/to/bge-m3

# One physical small model is shared by:
#   - /decompose
#   - /generate profile=decision
SMALL_LLM_MODEL_PATH=/path/to/qwen-4b

# Large final-response model:
RESPONSE_LLM_MODEL_PATH=/path/to/qwen-30b

BGE_BATCH_SIZE=16
BGE_MAX_SEQ_LENGTH=8192

DECOMPOSE_MAX_NEW_TOKENS=128
DECISION_MAX_OUTPUT_TOKENS=512
RESPONSE_MAX_OUTPUT_TOKENS=2048

SMALL_LLM_ENABLE_THINKING=false
RESPONSE_LLM_ENABLE_THINKING=false

GPU_TRUST_REMOTE_CODE=true
GPU_DEVICE_MAP=auto
