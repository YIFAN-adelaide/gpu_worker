GPU_SERVICE_HOST=127.0.0.1
GPU_SERVICE_PORT=8001

GPU_SERVICE_API_KEY=experteaseaitest1

GPU_QUEUE_MAXSIZE=32

GPU_EMBED_TIMEOUT_SECONDS=90
GPU_DECOMPOSE_TIMEOUT_SECONDS=120
GPU_GENERATE_TIMEOUT_SECONDS=600

GPU_LOAD_EMBEDDING=false
GPU_LOAD_SMALL_LLM=false
GPU_LOAD_RESPONSE_LLM=true

BGE_MODEL_PATH=/home/ubuntu/gputest/models/bge-m3
SMALL_LLM_MODEL_PATH=/home/ubuntu/gputest/models/qwen3-4b
RESPONSE_LLM_MODEL_PATH=/home/ubuntu/gputest/models/qwen3-30b-a3b-gptq-int4

BGE_BATCH_SIZE=16
BGE_MAX_SEQ_LENGTH=8192

DECOMPOSE_MAX_NEW_TOKENS=128
DECISION_MAX_OUTPUT_TOKENS=512
RESPONSE_MAX_OUTPUT_TOKENS=2048

SMALL_LLM_ENABLE_THINKING=false
RESPONSE_LLM_ENABLE_THINKING=false

GPU_TRUST_REMOTE_CODE=true
GPU_DEVICE_MAP=auto
